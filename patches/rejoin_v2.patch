         self.route_index = (self.route_index + 1) % len(self.route)
         self.destination = self.route[self.route_index]
 
+    def _nearest_leg_end(self) -> Tuple[float, int]:
+        """Return (distance_to_route, index of the waypoint ENDING the nearest leg).
+
+        Distance is measured to the route POLYLINE — every leg, by perpendicular
+        projection onto the segment — not to the waypoints.  Measuring to
+        waypoints picks the nearest corner, which for a vessel sitting beside the
+        middle of a long leg is the wrong end of the wrong leg.
+        """
+        n = len(self.route)
+        px, py = self.position
+        best_d, best_end = float("inf"), self.route_index
+        # Leg i runs route[i] -> route[i+1].  A looping route has one extra leg
+        # closing route[n-1] -> route[0]; a non-looping one does not, and pretending
+        # it does would offer a rejoin across a leg the vessel never sails.
+        last = n if self.route_loop else n - 1
+        for i in range(last):
+            ax, ay = self.route[i]
+            bx, by = self.route[(i + 1) % n]
+            dx, dy = bx - ax, by - ay
+            seg2 = dx * dx + dy * dy
+            if seg2 <= 0.0:
+                continue                      # degenerate leg (duplicate waypoint)
+            # Projection parameter clamped to the segment, so a vessel off the END
+            # of a leg measures to that endpoint rather than to the infinite line.
+            t = ((px - ax) * dx + (py - ay) * dy) / seg2
+            t = 0.0 if t < 0.0 else (1.0 if t > 1.0 else t)
+            cx, cy = ax + dx * t, ay + dy * t
+            d = sqrt((px - cx) ** 2 + (py - cy) ** 2)
+            if d < best_d:
+                best_d, best_end = d, (i + 1) % n
+        return best_d, best_end
+
+    def rejoin_route(self, world=None) -> bool:
+        """Re-index a DISPLACED vessel onto the nearest leg of its own route.
+
+        Returns True when route_index/destination were corrected, False when the
+        vessel's current aim was already viable and nothing needed changing.
+
+        This is the fix for KNOWN_ISSUES #11 mechanism 2.  Every "hand back to the
+        schedule" site used to do ``destination = route[route_index]`` — the one
+        waypoint the vessel happened to be steering for when it was pulled off
+        station.  A vessel towed 200 wu by a rescue, an MOB search or a tide
+        refloat is then aimed at a waypoint that may sit behind an island, which
+        is why 84% of groundings happen off-route against 1% on it.
+
+        Deliberately NOT player_commanded and NOT a multi-hop find_safe_path
+        route.  That was mechanism 1, measured and rejected twice: command state
+        IS the off-route condition (vessels stayed commanded 73-97% of runtime
+        with near-zero waypoint advances), and a commanded vessel is excluded from
+        SAR dispatch eligibility, so routing displaced vessels home that way
+        starved the rescuer pool and cost arrivals 503 -> 170.  The vessel resumes
+        ordinary schedule navigation; only the INDEX it resumes from is corrected.
+
+        IDEMPOTENT BY CONSTRUCTION, and that is a hard requirement, not a nicety.
+        The answer depends only on position, route and depth — never on the
+        current route_index — so calling this repeatedly at one position always
+        yields the same index.  The first version keyed a guard off route_index
+        ("if the nearest leg-end is the one I am already aimed at, take the next
+        one along"), which made the index oscillate 2,1,2,1,... on a stationary
+        vessel and cost arrivals 791 -> 237 with 22,347 re-groundings.
+
+        INTERVENES ONLY WHEN THE CURRENT AIM IS BLOCKED.  "Nearest leg-end" has no
+        notion of forward progress, so re-indexing a vessel whose run-in is
+        perfectly clear rewinds its schedule to a waypoint it already passed — it
+        then sails back, re-passes, and churns there forever.  Measured: released
+        rescuers churned 3 -> 2 -> 3 across 16k releases for a single vessel in
+        three sim-days.  So a clear current aim is always left alone; only a
+        blocked one is replaced.
+        """
+        if not self.route:
+            self.destination = None
+            return False
+        n = len(self.route)
+        if n == 1:
+            self.route_index = 0
+            self.destination = self.route[0]
+            return False
+
+        d_route, nearest_end = self._nearest_leg_end()
+
+        # Already on its own line: not displaced at all.  A vessel mid-leg, or
+        # jittered a world unit off it by a waypoint pass, owes the waypoints it
+        # is still heading for, and re-indexing would skip them.
+        if d_route <= ROUTE_REJOIN_ON_ROUTE_WU:
+            self.destination = self.route[self.route_index]
+            return False
+
+        # Displaced.  Depth-check the aim it already has before changing anything;
+        # see the anti-rewind note above.  Same test the SAR router uses, so
+        # "clear" means the same thing in both places.
+        if world is not None:
+            from engine.collision import leg_is_clear   # local import: keeps
+            # engine.collision off ship.py's module-load path, which data/ and
+            # several tests import for the dataclass alone.
+            if leg_is_clear(self.position, self.route[self.route_index],
+                            world, self.draft_m):
+                self.destination = self.route[self.route_index]
+                return False
+
+            # The current aim is genuinely blocked — this is the stale-waypoint-
+            # behind-an-island case rejoin exists for.  Take the nearest leg-end
+            # whose run-in is clear, walking forward if the nearest is not.
+            for step in range(ROUTE_REJOIN_MAX_LOOKAHEAD + 1):
+                cand = (nearest_end + step) % n
+                if leg_is_clear(self.position, self.route[cand],
+                                world, self.draft_m):
+                    if cand == self.route_index:
+                        self.destination = self.route[cand]
+                        return False
+                    self.route_index = cand
+                    self.destination = self.route[cand]
+                    return True
+
+        # Either no world was supplied (unit tests, callers without one) or
+        # nothing in the lookahead cleared.  Fall back to the nearest leg-end: it
+        # is still a measured answer where the stale index is not, and the
+        # grounding trigger remains the backstop.
+        if nearest_end == self.route_index:
+            self.destination = self.route[nearest_end]
+            return False
+        self.route_index = nearest_end
+        self.destination = self.route[nearest_end]
+        return True
+
