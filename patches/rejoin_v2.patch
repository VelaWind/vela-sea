+# Route rejoin geometry (KNOWN_ISSUES #11 mechanism 2).  A displaced vessel handed
+# back to its schedule used to be aimed at route[route_index] — the one waypoint it
+# happened to be steering for when it was pulled off station.  After a tow across
+# the sea that waypoint is frequently behind an island, which is why 84% of
+# groundings occur off-route.  Vessel.rejoin_route() re-indexes onto the nearest
+# LEG of the route instead; these two numbers bound that search.
+ROUTE_REJOIN_ON_ROUTE_WU = 6.0   # world units.  Within this of its own polyline a
+                                 # vessel is not displaced at all (it is mid-leg,
+                                 # or a waypoint-pass jittered it slightly off the
+                                 # line), so rejoin leaves route_index untouched.
+                                 # Sized just above SAFE_PATH_APPROACH_WU = 5.0 so
+                                 # normal approach wander never trips a re-index.
+ROUTE_REJOIN_MAX_LOOKAHEAD = 3   # waypoints to walk FORWARD when the run-in to
+                                 # the nearest leg-end is itself blocked.  Only
+                                 # the DEPTH of the run-in may refuse a candidate:
+                                 # refusing one for being the index the vessel
+                                 # already holds is what made rejoin non-idempotent
+                                 # (it stepped forward, then snapped back the next
+                                 # tick — 22,347 flap events on stationary vessels).
+                                 # Beyond a few waypoints the vessel is most of a
+                                 # lap from where it belongs and the nearest
+                                 # leg-end is the better answer.
+
 # Dispatch retry cooldown.  _sar_dispatch runs every sim step, and for a casualty
 # nobody can route to it re-walked every candidate every tick — each attempt a
 # find_standoff (up to 192 depth probes) plus a find_safe_path (~2,300 samples).
