+    def crabbed_heading(self, target: Position, environment=None) -> float:
+        """Return the heading whose COURSE OVER GROUND points at `target`.
+
+        bearing_to() aims the bow at the destination, but move() then adds
+        set-and-drift and wind leeway on top, so the actual track slides
+        downwind — over a long leg the vessel bows toward the lee shore even
+        though it is "steering at" the waypoint the whole way.  This offsets the
+        helm into the weather by the angle that cancels the across-track part of
+        the drift, which is what a watchkeeper does.
+
+        Solve V*sin(alpha) + drift_across = 0, so alpha = -asin(drift_across / V),
+        clamped to LEEWAY_CRAB_MAX_DEG.  Wind-powered hulls are exempt: their
+        propulsion is a function of the angle between heading and wind, so
+        crabbing would change the very thing driving them (see _effective_wind_speed)
+        and can stall them head-to-wind.  Motor vessels are where the groundings are.
+        """
+        bearing = self.bearing_to(target)
+        if environment is None or self.vessel_type == "sailboat":
+            return bearing
+        # Drift is the same vector sum move() applies, in knots.
+        cur_rad = radians(environment.current_direction)
+        drift_x = cos(cur_rad) * environment.current_speed * CURRENT_INFLUENCE
+        drift_y = sin(cur_rad) * environment.current_speed * CURRENT_INFLUENCE
+        push_rad = radians((environment.wind_direction + 180.0) % 360.0)
+        wind_kn = environment.wind_speed * self._windage_factor()
+        drift_x += cos(push_rad) * wind_kn
+        drift_y += sin(push_rad) * wind_kn
+
+        # Across-track component: project drift onto the normal of the desired
+        # course.  Along-track drift needs no helm — it only makes the passage
+        # faster or slower.
+        brg_rad = radians(bearing)
+        across = -sin(brg_rad) * drift_x + cos(brg_rad) * drift_y
+
+        speed = self.current_speed
+        if speed <= 0.1:
+            return bearing   # no steerage way — the helm cannot bite
+        ratio = max(-1.0, min(1.0, -across / speed))
+        alpha = degrees(asin(ratio))
+        alpha = max(-LEEWAY_CRAB_MAX_DEG, min(LEEWAY_CRAB_MAX_DEG, alpha))
+        return (bearing + alpha) % 360.0
+
     def at_destination(self, target: Position, tolerance: float = 1.0) -> bool:
         """Return True when the vessel is close enough to a destination."""
         return self.distance_to(target) <= tolerance
