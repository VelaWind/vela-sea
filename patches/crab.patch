 # Basis: IHO SP-44 and COLREGS §2 define set and drift as a vector sum.
 CURRENT_INFLUENCE = 1.0
 
+# Leeway compensation (crabbing).  Course-keeping steers HEADING at the
+# destination, but move() then adds wind and current on top, so course over
+# ground diverges from heading and the track bows downwind across a long leg.
+# That cost ~0.22 wu of clearance per knot of onshore wind and is the root cause
+# behind the Carrow grounding cluster.  A real watchkeeper offsets the helm into
+# the weather to hold the track; this is that offset.
+#
+# Clamped because the correction is asin(drift / speed): as speed approaches
+# zero the required angle explodes, and a near-stopped vessel cannot crab at all
+# — unclamped, slow vessels would steer wildly instead of holding course.
+LEEWAY_CRAB_MAX_DEG = 20.0   # degrees — maximum helm offset into the weather
+
 # Windage per vessel class (fraction of wind speed → lateral drift in knots)
 # Approximates (above-waterline profile area) / (underwater lateral resistance).
 # Values from Lewandowski (1994) "The Dynamics of Marine Craft" and RYA
