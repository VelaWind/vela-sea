+def _resume_schedule(vessel, world, player_paths) -> None:
+    """Send a displaced vessel back to its schedule along a VALIDATED path.
+
+    Every "hand back to the schedule" site used to do
+    ``destination = route[route_index]`` — a bare straight line from wherever
+    the vessel had ended up.  Rescue duty, MOB searches, trawl wander and party
+    tenders all leave vessels a long way off their route, and those return legs
+    crossed whatever land lay between: 84% of all groundings measured in a
+    14-day run happened more than 15 wu off the vessel's own route, against 1%
+    on it.  Dispatch legs were validated; the journey home was not.
+
+    Uses the same router and multi-hop machinery as SAR dispatch, so a return
+    leg gets the two-hop treatment when a direct one is unsafe.
+    """
+    if not vessel.route:
+        return
+    target = vessel.route[vessel.route_index]
+    path = find_safe_path(vessel.position, target, world, vessel.draft_m)
+    if not path:
+        # No safe way home right now.  Emphatically do NOT sail the straight
+        # line — that is the behaviour this function exists to remove.  Hold
+        # station and retry on the same cooldown SAR dispatch uses; the fleet
+        # and the tide both move, so a route usually appears.  destination is
+        # cleared rather than left in place because the vessel has just reached
+        # it, and leaving it set would re-fire arrival every tick.
+        vessel.destination = None
+        vessel.player_commanded = False
+        vessel._return_retry_timer = SAR_DISPATCH_RETRY_S
+        return
+    vessel.destination = path[0]
+    vessel._return_retry_timer = 0.0
+    if len(path) > 1:
+        # Multi-hop: ride the dispatch machinery — player_commanded keeps the
+        # scheduler's hands off until the last hop is reached, at which point
+        # the arrival handler calls back in here and the direct leg succeeds.
+        vessel.player_commanded = True
+        if player_paths is not None:
+            player_paths[id(vessel)] = path[1:]
+    else:
+        vessel.player_commanded = False
+        if player_paths is not None:
+            player_paths.pop(id(vessel), None)
+
