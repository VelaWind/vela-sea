# ── Python ──────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# ── PyInstaller packaging artifacts ─────────────────────────────────────────
# build/ and dist/ are regenerated by `pyinstaller meridian_sea.spec`; the
# release zip is a large binary artifact.  The .spec file IS tracked (it's the
# reproducible build recipe — see DISTRIBUTION.md).
dist/
build/
MeridianSea_*.zip

# ── pygbag / WebAssembly build (experimental, spike) ────────────────────────
# `python -m pygbag --build .` writes the web bundle under build/ (already
# ignored above) — apk/tar.gz/index.html + web-cache. These are large,
# regenerated artifacts; never commit them.  pygbag.ini (build-ignore config)
# and any itch.io archive are local build inputs/outputs, not project state.
build/web/
build/web-cache/
web.zip
*.apk
pygbag.ini

# ── Generated / debug artifacts ─────────────────────────────────────────────
debug_frame.png
tests/*.png
tools/preview_out/

# ── Editors ─────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Claude Code local config (machine-specific, not project state) ───────────
.claude/

# ── Player-local state (never committed) ──
save.json
settings.json
